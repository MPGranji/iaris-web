# Local development only. npm run local:setup generates backend/.env locally.
# For a separate test PostgreSQL instance, fill these values yourself.
DATABASE_URL=""
PORT=4001
APP_ORIGINS="http://127.0.0.1:5176,http://localhost:5176"
CORS_ORIGINS=""
# Used only to create the first administrator on an empty database.
BOOTSTRAP_ADMIN_EMAIL="admin@iaris.local"
BOOTSTRAP_ADMIN_PASSWORD=""
# Opt in to the public demo account admin/admin and demo form-to-admin links.
DEMO_ADMIN_LOGIN=false
# Legacy API token; the connected admin uses cookie sessions instead.
ADMIN_TOKEN=""

# Consultation email. preview stores messages in admin without sending externally.
# To send real mail, fill SMTP credentials then set MAIL_MODE="smtp" and restart API.
MAIL_MODE="preview"
CONSULTATION_TO=""
MAIL_FROM=""
MAIL_REPLY_TO=""
ADMIN_APP_URL="http://127.0.0.1:5176"
PUBLIC_SITE_URL="http://127.0.0.1:5175"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASSWORD=""
