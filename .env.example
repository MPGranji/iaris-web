# Copy to backend/.env for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local Docker).
# Leave empty to run the site on the built-in static content (form submissions are then not stored).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iaris?schema=public"

# Token for the admin-only endpoints (GET /api/leads, PATCH /api/leads/:id).
# Send it as header:  Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Comma-separated list of extra origins allowed to call the API (only needed when the
# frontend is hosted on a different domain than the API). Same-origin always works.
CORS_ORIGINS=""

# Local API port (ignored on Vercel)
PORT=4000
